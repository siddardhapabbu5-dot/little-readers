generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  TEACHER
  SCHOOL_ADMIN
  ADMIN
  SUPER_ADMIN
}

enum SchoolStaffRole {
  TEACHER
  SCHOOL_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  EXPIRED
  CANCELLED
  PENDING
  SUSPENDED
  GRACE
}

enum ConsentType {
  TERMS
  PRIVACY
  PARENTAL
  MICROPHONE
  DATA_PROCESSING
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum AttemptType {
  READING
  SPELLING
  SPEECH
  QUIZ
  DICTATION
  LISTENING
  MATCHING
  MEMORY
  ALPHABET
  PHONICS
  GRAMMAR
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentPurpose {
  FAMILY_MONTHLY
  FAMILY_YEARLY
  FAMILY_3_MONTH
  FAMILY_6_MONTH
  EXTRA_SEATS
  MANUAL_ADMIN
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LearningLevelKind {
  /// Age-band grade surface (LEVEL_1…LEVEL_4 map to GRADE_1…GRADE_4)
  GRADE_BAND
  /// Difficulty progression within a grade
  DIFFICULTY
}

enum DictionaryImportStatus {
  PENDING
  PARSED
  CLASSIFIED
  FAILED
  CANCELLED
}

enum VocabAssignmentStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum VocabWordOrigin {
  /// Pre-existing / manually created kids vocabulary (never auto-wiped)
  LEGACY
  /// Created from an approved dictionary assignment
  DICTIONARY
  /// Category-targeted VocabImportBatch
  CATEGORY_IMPORT
}

enum ParentSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// E.164 mobile for Parent OTP login (e.g. +9198XXXXXXXX). Optional for Admin.
  mobileE164   String?  @unique
  passwordHash String
  role         UserRole @default(PARENT)
  isActive     Boolean  @default(true)
  /// Bumped on Admin password reset so prior JWTs (iat before this) are rejected.
  passwordChangedAt DateTime?
  /// Parent gate PIN (bcrypt). Required before kids chrome opens adult tools.
  parentPinHash String?
  parentPinUpdatedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  children          Child[]
  subscriptions     Subscription[]
  payments          Payment[]
  parentalConsents  ParentalConsent[]
  adminRoleBindings AdminRoleBinding[]
  certificatesIssued Certificate[] @relation("IssuedByAdmin")
  vocabImports      VocabImportBatch[]
  dictionaryImports DictionaryImportBatch[]
  vocabAssignmentsReviewed VocabularyGradeAssignment[] @relation("AssignmentReviewer")
  passwordResetTokens PasswordResetToken[]
  adminPasswordResetTokens AdminPasswordResetToken[]
  schoolStaff         SchoolStaff[]
  classroomTeaching   ClassroomTeacher[]
  lessonAssignmentsMade ClassroomLessonAssignment[] @relation("AssignedByTeacher")
  programmesCreated   VocabProgramme[] @relation("ProgrammeCreatedBy")
  programmesApproved  VocabProgramme[] @relation("ProgrammeApprovedBy")
  programmesActivated VocabProgramme[] @relation("ProgrammeActivatedBy")
  publisherConfigUpdates VocabPublisherConfig[] @relation("PublisherConfigUpdatedBy")
  adminAlerts         AdminAlert[]
  parentOtpVerifications ParentOtpVerification[]
  parentDeviceSessions   ParentDeviceSession[]

  @@index([role])
  @@index([mobileE164])
}

/// Hashed OTP challenges for Parent mobile login (never store plaintext OTP).
model ParentOtpVerification {
  id           String    @id @default(cuid())
  parentId     String?
  mobileE164   String
  otpHash      String
  expiresAt    DateTime
  attempts     Int       @default(0)
  verifiedAt   DateTime?
  consumedAt   DateTime?
  invalidatedAt DateTime?
  createdAt    DateTime  @default(now())

  parent User? @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([mobileE164, createdAt])
  @@index([parentId])
  @@index([expiresAt])
}

/// One ACTIVE parent app session per parent (single-device policy). History retained.
model ParentDeviceSession {
  id               String              @id @default(cuid())
  parentId         String
  deviceId         String
  deviceName       String?
  platform         String
  appVersion       String?
  refreshTokenHash String
  status           ParentSessionStatus @default(ACTIVE)
  createdAt        DateTime            @default(now())
  lastSeenAt       DateTime            @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, status])
  @@index([deviceId])
  @@index([expiresAt])
}

/** One-time password recovery tokens (hashed at rest). */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/** Admin-only password reset tokens (hashed at rest). Separate from parent/general reset. */
model AdminPasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model Child {
  id          String   @id @default(cuid())
  parentId    String
  displayName String
  birthYear   Int
  /// Display/storage as DD/MM/YYYY (e.g. 15/03/2021). birthYear stays for age/level logic.
  birthDate   String?
  levelId     String?
  /// Canonical academic school grade (gradeNumber 1–12). Optional; never auto-cleared on migrate.
  gradeId     String?
  ageGroupId  String?
  avatarUrl   String?
  isActive    Boolean  @default(true)
  /// True when this child occupies one of the parent's subscription learning seats.
  hasLearningSeat Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   User            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  level    LearningLevel?  @relation(fields: [levelId], references: [id])
  grade    LearningGrade?  @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  ageGroup AgeGroup?       @relation(fields: [ageGroupId], references: [id])

  attempts           LearningAttempt[]
  progress           LearningProgress?
  speechAssessments  SpeechAssessment[]
  rewards            Reward[]
  certificates       Certificate[]
  learningSessions   LearningSession[]
  categoryProgress   ChildCategoryProgress[]
  lessonProgress     ChildLessonProgress[]
  achievements       Achievement[]
  registeredDevice   StudentDevice?
  deviceTransfers    DeviceTransferEvent[]
  classroomEnrollments ClassroomEnrollment[]

  @@index([parentId])
  @@index([gradeId])
  @@index([levelId])
}

model ParentalConsent {
  id          String      @id @default(cuid())
  userId      String
  consentType ConsentType
  version     String
  acceptedAt  DateTime    @default(now())
  ipAddress   String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
}

model AgeGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  ageMin      Int
  ageMax      Int
  description String?
  createdAt   DateTime @default(now())

  children Child[]
  lessons  Lesson[]
}

/// Academic / age-band grade. School grades use gradeNumber (1–12) + assignedLevelId.
/// Legacy content bands (GRADE_1…) keep gradeNumber null and may point at a canonical academic row.
model LearningGrade {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  description String?
  ageMin      Int
  ageMax      Int
  /// School grade number (1–12). Null for legacy age-band / content grades.
  gradeNumber Int?
  /// Level this school grade belongs to (Level-1 / Level-2 / Level-3).
  assignedLevelId String?
  /// For legacy content grades: link to canonical academic grade (same school year).
  canonicalGradeId String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  /// Parent app visibility (published catalog).
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels         LearningLevel[]  @relation("LevelPrimaryGrade")
  assignedLevel  LearningLevel?   @relation("GradesInLevel", fields: [assignedLevelId], references: [id], onDelete: SetNull)
  canonicalGrade LearningGrade?   @relation("GradeCanonical", fields: [canonicalGradeId], references: [id], onDelete: SetNull)
  legacyAliases  LearningGrade[]  @relation("GradeCanonical")
  children       Child[]
  assignments    VocabularyGradeAssignment[]
  lessons        Lesson[]
  programmes     VocabProgramme[]

  @@unique([gradeNumber])
  @@index([assignedLevelId])
  @@index([canonicalGradeId])
  @@index([isActive, isPublished])
}

model LearningLevel {
  id          String            @id @default(cuid())
  code        String            @unique
  label       String
  sortOrder   Int               @default(0)
  description String?
  ageMin      Int               @default(3)
  ageMax      Int               @default(12)
  /// Inclusive school grade range for this level (e.g. 1–3).
  startGrade  Int?
  endGrade    Int?
  kind        LearningLevelKind @default(GRADE_BAND)
  gradeId     String?
  isActive    Boolean           @default(true)
  /// Parent app visibility (published catalog).
  isPublished Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  grade            LearningGrade?      @relation("LevelPrimaryGrade", fields: [gradeId], references: [id], onDelete: SetNull)
  schoolGrades     LearningGrade[]     @relation("GradesInLevel")
  children         Child[]
  lessons          Lesson[]
  groups           LearningGroup[]
  vocabImports     VocabImportBatch[]
  assignments      VocabularyGradeAssignment[]
  subscriptionPlans SubscriptionPlan[]

  @@index([gradeId])
  @@index([isActive, isPublished])
}

/// Admin-managed parent subscription catalog (amounts in paise). Historical payments keep snapshots.
model SubscriptionPlan {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique
  description      String?
  /// 1 | 3 | 6 | 12
  durationMonths   Int
  amountPaise      Int
  currency         String   @default("INR")
  /// LEVEL_1 | LEVEL_2 | LEVEL_3 | ALL
  applicableLevel  String   @default("ALL")
  levelId          String?
  includedSeats    Int      @default(2)
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  level LearningLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  @@index([isActive, isPublished])
  @@index([applicableLevel])
  @@index([levelId])
}

enum VocabRound {
  LISTEN
  SPELL
  LETTER
  MATCHING
  QUIZ
  REVISION
}

enum LearningSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model LearningGroup {
  id          String   @id @default(cuid())
  levelId     String
  code        String
  label       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  level      LearningLevel      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  categories LearningCategory[]
  lessons    Lesson[]

  @@unique([levelId, code])
  @@index([levelId])
  @@index([isActive])
}

model LearningCategory {
  id          String   @id @default(cuid())
  groupId     String
  code        String
  label       String
  description String?
  emoji       String   @default("📚")
  sortOrder   Int      @default(0)
  unlockOrder Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group      LearningGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  words      VocabularyWord[]
  sessions   LearningSession[]
  progress   ChildCategoryProgress[]
  vocabImports VocabImportBatch[]
  assignments  VocabularyGradeAssignment[]
  lessons      Lesson[]

  @@unique([groupId, code])
  @@index([groupId, sortOrder])
}

enum VocabImportStatus {
  PENDING
  IMPORTED
  FAILED
  CANCELLED
}

model VocabImportBatch {
  id               String            @id @default(cuid())
  adminId          String
  levelId          String
  categoryId       String
  originalFilename String
  storedPath       String
  mimeType         String
  fileExt          String
  fileSize         Int
  fileHash         String
  status           VocabImportStatus @default(PENDING)
  extractedCount   Int               @default(0)
  validCount       Int               @default(0)
  invalidCount     Int               @default(0)
  duplicateCount   Int               @default(0)
  importedCount    Int               @default(0)
  skippedCount     Int               @default(0)
  previewJson      String            @db.Text
  parseNotes       String?
  errorMessage     String?
  createdAt        DateTime          @default(now())
  importedAt       DateTime?

  admin    User             @relation(fields: [adminId], references: [id], onDelete: Cascade)
  level    LearningLevel    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  category LearningCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([categoryId, createdAt])
  @@index([fileHash])
  @@index([status])
}

model VocabularyWord {
  id          String   @id @default(cuid())
  categoryId  String
  /// Canonical vocabulary spelling (API: word)
  text        String
  /// Age-appropriate definition (API: simpleMeaning)
  meaning     String
  emoji       String
  imageUrl    String?
  audioUrl    String?
  /// Pronunciation guide / IPA hint (API: pronunciation)
  phonetic    String?
  firstLetter String   @default("")
  difficulty  Int      @default(1)
  /// Display order within category (API: displayOrder)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  origin      VocabWordOrigin @default(LEGACY)
  dictionarySenseId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category        LearningCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dictionarySense DictionarySense?   @relation(fields: [dictionarySenseId], references: [id], onDelete: SetNull)
  attempts        QuestionAttempt[]
  publishedFrom   VocabularyGradeAssignment[]
  lessonItems     LessonVocabItem[]
  programmeItems  VocabProgrammeItem[]

  /// Same headword may exist in multiple grade categories; not globally unique.
  @@unique([categoryId, text])
  @@index([categoryId, sortOrder])
  @@index([isActive, categoryId])
  @@index([firstLetter])
  @@index([dictionarySenseId])
}

model DictionaryImportBatch {
  id               String                 @id @default(cuid())
  adminId          String
  originalFilename String
  storedPath       String
  mimeType         String
  fileExt          String
  fileSize         Int
  fileHash         String
  status           DictionaryImportStatus @default(PENDING)
  sourceName       String?
  licence          String?
  extractedCount   Int                    @default(0)
  entryCount       Int                    @default(0)
  senseCount       Int                    @default(0)
  duplicateCount   Int                    @default(0)
  assignmentCount  Int                    @default(0)
  parseNotes       String?
  errorMessage     String?
  previewJson      String?                @db.Text
  createdAt        DateTime               @default(now())
  classifiedAt     DateTime?

  admin   User              @relation(fields: [adminId], references: [id], onDelete: Cascade)
  entries DictionaryEntry[]

  @@index([adminId, createdAt])
  @@index([fileHash])
  @@index([status])
}

/// One dictionary headword — never duplicated per grade.
model DictionaryEntry {
  id                 String   @id @default(cuid())
  normalizedHeadword String   @unique
  headword           String
  pronunciation      String?
  audioUrl           String?
  sourceName         String?
  licence            String?
  sourceRef          String?
  importBatchId      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  importBatch DictionaryImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  senses      DictionarySense[]

  @@index([importBatchId])
}

model DictionarySense {
  id             String   @id @default(cuid())
  entryId        String
  senseIndex     Int      @default(0)
  definition     String
  wordType       String?
  synonymsJson   String?
  antonymsJson   String?
  examplesJson   String?
  relationsJson  String?
  rawPayloadJson String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entry       DictionaryEntry             @relation(fields: [entryId], references: [id], onDelete: Cascade)
  assignments VocabularyGradeAssignment[]
  words       VocabularyWord[]

  @@unique([entryId, senseIndex])
  @@index([entryId])
}

model VocabularyGradeAssignment {
  id                     String               @id @default(cuid())
  senseId                String
  gradeId                String
  levelId                String
  categoryId             String
  status                 VocabAssignmentStatus @default(PENDING)
  difficultyScore        Float                @default(0)
  confidenceScore        Float                @default(0)
  explanation            String               @db.Text
  classificationVersion  String
  publishedWordId        String?
  reviewedById           String?
  reviewedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  sense         DictionarySense  @relation(fields: [senseId], references: [id], onDelete: Cascade)
  grade         LearningGrade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  level         LearningLevel    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  category      LearningCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  publishedWord VocabularyWord?  @relation(fields: [publishedWordId], references: [id], onDelete: SetNull)
  reviewedBy    User?            @relation("AssignmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([senseId, gradeId, categoryId])
  @@index([status, confidenceScore])
  @@index([gradeId, status])
  @@index([categoryId, status])
}

model LearningSession {
  id              String                @id @default(cuid())
  childId         String
  categoryId      String
  /// When set, word pool comes from LessonVocabItem (Listen/Spell reuse).
  lessonId        String?
  status          LearningSessionStatus @default(IN_PROGRESS)
  listenScore     Int                   @default(0)
  spellScore      Int                   @default(0)
  listenCorrect   Int                   @default(0)
  spellCorrect    Int                   @default(0)
  questionsTotal  Int                   @default(0)
  points          Int                   @default(0)
  stars           Int                   @default(0)
  wordsLearned    Int                   @default(0)
  durationSec     Int                   @default(0)
  startedAt       DateTime              @default(now())
  completedAt     DateTime?

  child     Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  category  LearningCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  lesson    Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attempts  QuestionAttempt[]

  @@index([childId, startedAt])
  @@index([categoryId])
  @@index([lessonId, childId, status])
}

model QuestionAttempt {
  id           String     @id @default(cuid())
  sessionId    String
  wordId       String
  round        VocabRound
  isCorrect    Boolean
  answerGiven  String?
  usedClue     Boolean    @default(false)
  pointsAwarded Int       @default(0)
  createdAt    DateTime   @default(now())

  session LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word    VocabularyWord  @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([sessionId, round])
}

model ChildCategoryProgress {
  id             String   @id @default(cuid())
  childId        String
  categoryId     String
  wordsLearned   Int      @default(0)
  listenCorrect  Int      @default(0)
  listenAttempts Int      @default(0)
  spellCorrect   Int      @default(0)
  spellAttempts  Int      @default(0)
  points         Int      @default(0)
  stars          Int      @default(0)
  completed      Boolean  @default(false)
  minutesLearned Int      @default(0)
  lastPlayedAt   DateTime?
  updatedAt      DateTime @updatedAt

  child    Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  category LearningCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([childId, categoryId])
  @@index([childId])
}

model Achievement {
  id          String   @id @default(cuid())
  childId     String
  code        String
  title       String
  description String?
  earnedAt    DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, code])
  @@index([childId])
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  lessons Lesson[]
}

model Lesson {
  id           String        @id @default(cuid())
  title        String
  description  String?
  subjectId    String?
  ageGroupId   String?
  levelId      String?
  /// Legacy free-text category label (kept for Phase-1 seed compatibility).
  category     String
  gradeId      String?
  groupId      String?
  /// Preferred LearningCategory placement for vocabulary + play.
  learningCategoryId String?
  difficulty   Int           @default(1)
  status       PublishStatus @default(DRAFT)
  isPublished  Boolean       @default(false)
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  instructions String?
  /// Supported activities JSON, e.g. ["LISTEN","SPELL"] — Matching/Tracing not implemented.
  activitiesJson String      @default("[\"LISTEN\",\"SPELL\"]")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  subject            Subject?          @relation(fields: [subjectId], references: [id])
  ageGroup           AgeGroup?         @relation(fields: [ageGroupId], references: [id])
  level              LearningLevel?    @relation(fields: [levelId], references: [id])
  grade              LearningGrade?    @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  group              LearningGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  learningCategory   LearningCategory? @relation(fields: [learningCategoryId], references: [id], onDelete: SetNull)

  lessonWords   LessonWord[]
  vocabItems    LessonVocabItem[]
  media         MediaAsset[]
  attempts      LearningAttempt[]
  quizzes       Quiz[]
  stories       Story[]
  sessions      LearningSession[]
  childProgress ChildLessonProgress[]
  classroomAssignments ClassroomLessonAssignment[]

  @@index([category, isPublished])
  @@index([status])
  @@index([isActive, isPublished])
  @@index([learningCategoryId])
  @@index([gradeId, levelId])
}

/// Kids vocabulary linked into a lesson (does not modify VocabularyWord).
model LessonVocabItem {
  id               String @id @default(cuid())
  lessonId         String
  vocabularyWordId String
  sortOrder        Int    @default(0)

  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabularyWord VocabularyWord @relation(fields: [vocabularyWordId], references: [id], onDelete: Restrict)

  @@unique([lessonId, vocabularyWordId])
  @@index([lessonId, sortOrder])
}

model ChildLessonProgress {
  id            String   @id @default(cuid())
  childId       String
  lessonId      String
  completed     Boolean  @default(false)
  points        Int      @default(0)
  stars         Int      @default(0)
  wordsLearned  Int      @default(0)
  listenCorrect Int      @default(0)
  spellCorrect  Int      @default(0)
  minutesLearned Int     @default(0)
  lastPlayedAt  DateTime?
  updatedAt     DateTime @updatedAt

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([childId, lessonId])
  @@index([childId])
  @@index([lessonId])
}

model Word {
  id           String   @id @default(cuid())
  text         String
  phonetic     String?
  definition   String?
  difficulty   Int      @default(1)
  ageMin       Int      @default(3)
  ageMax       Int      @default(12)
  imageAssetId String?
  audioAssetId String?
  createdAt    DateTime @default(now())

  lessonWords LessonWord[]
  imageAsset  MediaAsset?  @relation("WordImage", fields: [imageAssetId], references: [id])
  audioAsset  MediaAsset?  @relation("WordAudio", fields: [audioAssetId], references: [id])

  @@unique([text])
  @@index([difficulty])
}

model Phonic {
  id           String   @id @default(cuid())
  grapheme     String
  phoneme      String
  exampleWord  String?
  description  String?
  audioAssetId String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  audioAsset MediaAsset? @relation(fields: [audioAssetId], references: [id])

  @@unique([grapheme, phoneme])
}

model LessonWord {
  id       String @id @default(cuid())
  lessonId String
  wordId   String
  sortOrder Int   @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([lessonId, wordId])
}

model MediaAsset {
  id           String    @id @default(cuid())
  type         MediaType
  url          String
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  altText      String?
  provider     String    @default("local")
  providerRef  String?
  createdAt    DateTime  @default(now())

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  wordsAsImage Word[]   @relation("WordImage")
  wordsAsAudio Word[]   @relation("WordAudio")
  phonics      Phonic[]
  stories      Story[]  @relation("StoryCover")
}

model Story {
  id           String        @id @default(cuid())
  title        String
  summary      String?
  content      String
  ageMin       Int           @default(3)
  ageMax       Int           @default(12)
  status       PublishStatus @default(DRAFT)
  isPublished  Boolean       @default(false)
  coverAssetId String?
  lessonId     String?
  audioAssetId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  coverAsset MediaAsset? @relation("StoryCover", fields: [coverAssetId], references: [id])
  lesson     Lesson?     @relation(fields: [lessonId], references: [id])
}

model Quiz {
  id          String        @id @default(cuid())
  title       String
  description String?
  lessonId    String?
  ageMin      Int           @default(3)
  ageMax      Int           @default(12)
  status      PublishStatus @default(DRAFT)
  isPublished Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lesson    Lesson?         @relation(fields: [lessonId], references: [id])
  questions QuizQuestion[]
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  prompt        String
  optionsJson   String
  correctAnswer String
  explanation   String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model LearningAttempt {
  id          String      @id @default(cuid())
  childId     String
  lessonId    String?
  attemptType AttemptType
  score       Float?
  completed   Boolean     @default(false)
  payloadJson String?
  durationSec Int?
  createdAt   DateTime    @default(now())

  child  Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id])

  speechAssessments SpeechAssessment[]

  @@index([childId, createdAt])
  @@index([lessonId])
}

model SpeechAssessment {
  id               String   @id @default(cuid())
  childId          String
  attemptId        String?
  expectedText     String
  transcribedText  String?
  confidence       Float?
  accuracyScore    Float?
  feedback         String?
  phonemeJson      String?
  provider         String?
  /// Voice audio is assessed ephemerally; only scores/text are stored.
  createdAt        DateTime @default(now())

  child   Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  attempt LearningAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([childId, createdAt])
}

model LearningProgress {
  id              String   @id @default(cuid())
  childId         String   @unique
  wordsLearned    Int      @default(0)
  readingScore    Float    @default(0)
  spellingScore   Float    @default(0)
  pronunciationScore Float @default(0)
  minutesLearned  Int      @default(0)
  weakWordsJson   String?
  updatedAt       DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Reward {
  id          String   @id @default(cuid())
  childId     String
  title       String
  description String?
  badgeCode   String?
  points      Int      @default(0)
  earnedAt    DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  plan        String
  status      SubscriptionStatus
  startedAt   DateTime
  expiresAt   DateTime
  cancelledAt DateTime?
  provider    String
  providerRef String?            @unique
  graceEndsAt DateTime?
  /// Base child seats included in the parent plan (standard = 2).
  includedSeats Int              @default(2)
  /// Extra paid child seats activated after verified payment / admin grant.
  extraSeats    Int              @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, status])
}

/// One active registered mobile installation per child (student).
model StudentDevice {
  id               String   @id @default(cuid())
  childId          String   @unique
  installationId   String
  platform         String
  deviceLabel      String?
  appVersion       String?
  registeredAt     DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  revokedAt        DateTime?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([installationId, childId])
  @@index([installationId])
  @@index([isActive])
}

model DeviceTransferEvent {
  id               String   @id @default(cuid())
  childId          String
  approvedByUserId String
  previousInstallationId String?
  newInstallationId      String?
  reason           String?
  action           String
  createdAt        DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt])
  @@index([approvedByUserId])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amountCents    Int
  currency       String        @default("USD")
  status         PaymentStatus
  provider       String
  providerRef    String?       @unique
  invoiceUrl     String?
  paidAt         DateTime?
  /// Checkout / admin purpose (Batch 10).
  purpose          PaymentPurpose @default(MANUAL_ADMIN)
  seatsPurchased   Int            @default(0)
  planCode         String?
  razorpayOrderId  String?
  razorpayPaymentId String?
  /// Webhook event id for idempotency (optional).
  rawEventId       String?        @unique
  metadataJson     String?
  createdAt      DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId, createdAt])
  @@index([razorpayOrderId])
  @@index([status, purpose])
}

model Certificate {
  id          String   @id @default(cuid())
  childId     String
  title       String
  description String?
  issuedAt    DateTime @default(now())
  issuedById  String?
  templateCode String?

  child    Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  issuedBy User? @relation("IssuedByAdmin", fields: [issuedById], references: [id])

  @@index([childId])
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  bindings    AdminRoleBinding[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  adminRoleId  String
  permissionId String

  adminRole  AdminRole  @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([adminRoleId, permissionId])
}

model AdminRoleBinding {
  id          String   @id @default(cuid())
  userId      String
  adminRoleId String
  assignedAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminRole AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)

  @@unique([userId, adminRoleId])
}

/// Multi-school tenant. Parent→Child remains canonical; school is an overlay.
model School {
  id           String   @id @default(cuid())
  name         String
  code         String?  @unique
  contactEmail String?
  contactPhone String?
  address      String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff       SchoolStaff[]
  classrooms  Classroom[]

  @@index([isActive, name])
}

/// Links TEACHER / SCHOOL_ADMIN users to a school (no duplicate Child accounts).
model SchoolStaff {
  id        String          @id @default(cuid())
  schoolId  String
  userId    String
  staffRole SchoolStaffRole
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId, staffRole])
  @@index([userId, isActive])
}

model Classroom {
  id         String   @id @default(cuid())
  schoolId   String
  name       String
  code       String?
  gradeLabel String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school       School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers     ClassroomTeacher[]
  enrollments  ClassroomEnrollment[]
  assignments  ClassroomLessonAssignment[]

  @@index([schoolId, isActive])
  @@unique([schoolId, name])
}

model ClassroomTeacher {
  id            String   @id @default(cuid())
  classroomId   String
  teacherUserId String
  assignedAt    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacher   User      @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)

  @@unique([classroomId, teacherUserId])
  @@index([teacherUserId])
}

/// Enrolls an existing Child profile into a classroom (never creates a second child).
model ClassroomEnrollment {
  id          String    @id @default(cuid())
  classroomId String
  childId     String
  isActive    Boolean   @default(true)
  enrolledAt  DateTime  @default(now())
  leftAt      DateTime?

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([classroomId, childId])
  @@index([childId, isActive])
  @@index([classroomId, isActive])
}

/// Organizational lesson assignment — reuses existing Lesson / ChildLessonProgress.
model ClassroomLessonAssignment {
  id               String   @id @default(cuid())
  classroomId      String
  lessonId         String
  assignedByUserId String
  assignedAt       DateTime @default(now())

  classroom  Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lesson     Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  assignedBy User      @relation("AssignedByTeacher", fields: [assignedByUserId], references: [id], onDelete: Cascade)

  @@unique([classroomId, lessonId])
  @@index([lessonId])
  @@index([assignedByUserId])
}

enum VocabProgrammeStatus {
  DRAFT
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VocabProgrammeDayStatus {
  SCHEDULED
  PUBLISHED
  SKIPPED
  FAILED
}

/// Six-month (or custom) vocabulary publishing programme per grade.
model VocabProgramme {
  id             String               @id @default(cuid())
  title          String
  gradeId        String
  startDate      DateTime             @db.Date
  endDate        DateTime             @db.Date
  dailyTarget    Int                  @default(1)
  timezone       String               @default("Asia/Kolkata")
  status         VocabProgrammeStatus @default(DRAFT)
  createdById    String
  approvedById   String?
  activatedById  String?
  approvedAt     DateTime?
  activatedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  grade       LearningGrade       @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("ProgrammeCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?               @relation("ProgrammeApprovedBy", fields: [approvedById], references: [id])
  activatedBy User?               @relation("ProgrammeActivatedBy", fields: [activatedById], references: [id])
  days        VocabProgrammeDay[]

  @@index([gradeId, status])
  @@index([status, startDate])
}

model VocabProgrammeDay {
  id          String                   @id @default(cuid())
  programmeId String
  date        DateTime                 @db.Date
  status      VocabProgrammeDayStatus  @default(SCHEDULED)
  note        String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  programme VocabProgramme           @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  items     VocabProgrammeItem[]
  logs      VocabProgrammePublishLog[]
  publishJob VocabPublishJob?

  @@unique([programmeId, date])
  @@index([programmeId, status])
  @@index([date, status])
}

model VocabProgrammeItem {
  id               String @id @default(cuid())
  dayId            String
  vocabularyWordId String
  sortOrder        Int    @default(0)

  day            VocabProgrammeDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  vocabularyWord VocabularyWord    @relation(fields: [vocabularyWordId], references: [id], onDelete: Restrict)

  @@unique([dayId, vocabularyWordId])
  @@index([dayId, sortOrder])
}

model VocabProgrammePublishLog {
  id        String   @id @default(cuid())
  dayId     String
  result    String
  error     String?
  ranAt     DateTime @default(now())

  day VocabProgrammeDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId, ranAt])
}

enum VocabPublisherRunStatus {
  RUNNING
  PAUSED
  STOPPED
}

enum VocabPublishJobStatus {
  PENDING
  CLAIMED
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Singleton-ish publisher settings (id = "default").
model VocabPublisherConfig {
  id            String                  @id @default("default")
  timezone      String                  @default("Asia/Kolkata")
  /// Local hour in timezone (0–23) when due days become publishable.
  publishHour   Int                     @default(6)
  publishMinute Int                     @default(0)
  status        VocabPublisherRunStatus @default(RUNNING)
  updatedAt     DateTime                @updatedAt
  updatedById   String?

  updatedBy User? @relation("PublisherConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Database-backed daily publish jobs (claimed by the API process worker).
model VocabPublishJob {
  id            String                @id @default(cuid())
  dayId         String                @unique
  programmeId   String
  /// Calendar date to publish (UTC date matching programme day).
  dueDate       DateTime              @db.Date
  status        VocabPublishJobStatus @default(PENDING)
  attempts      Int                   @default(0)
  maxAttempts   Int                   @default(5)
  nextAttemptAt DateTime              @default(now())
  lastError     String?
  claimedAt     DateTime?
  claimedBy     String?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  day VocabProgrammeDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([programmeId, status])
  @@index([dueDate, status])
}

model AdminAlert {
  id          String   @id @default(cuid())
  type        String
  title       String
  body        String   @db.Text
  programmeId String?
  dayId       String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById String?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isRead, createdAt])
  @@index([type, createdAt])
}
