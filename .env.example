# Copy to .env and fill in real values. Never commit secrets.
# Full matrix: docs/ops/ENVIRONMENT_VARIABLES.md
# Production ops (approval-gated): docs/ops/PHASE4_PRODUCTION_OPS_PLAN.md
# Release prep: docs/ops/PHASE5_RELEASE_PREPARATION.md

# Database
POSTGRES_USER=little_readers
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=little_readers
POSTGRES_PORT=5437
DATABASE_URL=postgresql://little_readers:change_me_strong_password@localhost:5437/little_readers?schema=public

# Redis (BullMQ from Phase 2+)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Legacy Express API (preserved)
NODE_ENV=development
PORT=4100
CORS_ORIGIN=http://localhost:3100
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
# Parent OTP access JWT (short) + refresh on ParentDeviceSession
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Parent OTP + SMS (Phase 9). Default local = console + OTP_DEV_MODE.
# Never commit SMS secrets. OTP is never returned in production API JSON.
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_DEV_MODE=1
SMS_PROVIDER=console
# Production SMS (do not invent credentials — set on Hostinger only with approval):
# SMS_PROVIDER=msg91
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMS_TEMPLATE_ID=
# SMS_HTTP_URL=
DEFAULT_COUNTRY_CODE=+91

# NestJS API (primary going forward)
API_PORT=4200

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4100/api
NEXT_PUBLIC_NEST_API_URL=http://localhost:4200/api

# Password reset (production must use real email delivery)
APP_PUBLIC_URL=http://localhost:3100
MOBILE_PUBLIC_URL=http://localhost:8081
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Admin forgot-password tokens (separate AdminPasswordResetToken table)
ADMIN_PASSWORD_RESET_TOKEN_TTL_MINUTES=15
# Parent “forgot mobile” support contact
SUPPORT_EMAIL=support@littlereaders.example
# PASSWORD_RESET_LOG_ONLY=true  # non-production only
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@example.com
# Production: serve API/apps over HTTPS only; never log reset tokens.

# Razorpay (Batch 10) — sandbox/test keys only until authorized live cutover
# Never invent plan prices; leave amounts empty to disable checkout.
PAYMENT_ENABLED=false
# RAZORPAY_KEY_ID=rzp_test_…
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
# PLAN_FAMILY_MONTHLY_AMOUNT_PAISE=
# PLAN_FAMILY_YEARLY_AMOUNT_PAISE=
# PLAN_EXTRA_SEAT_AMOUNT_PAISE=
TAX_RATE_BPS=0

# Mobile → website checkout handoff
# EXPO_PUBLIC_WEB_APP_URL=http://localhost:3100
# EXPO_PUBLIC_API_URL=http://localhost:4100/api

# Private media / speech — leave empty until required phases
# Never use dummy payment confirmation or claim live gateway without keys.
