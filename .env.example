# Copy to .env and fill in real values. Never commit secrets.

# Database
POSTGRES_USER=little_readers
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=little_readers
POSTGRES_PORT=5437
DATABASE_URL=postgresql://little_readers:change_me_strong_password@localhost:5437/little_readers?schema=public

# Redis (BullMQ from Phase 2+)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Legacy Express API (preserved)
NODE_ENV=development
PORT=4100
CORS_ORIGIN=http://localhost:3100
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# NestJS API (primary going forward)
API_PORT=4200

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4100/api
NEXT_PUBLIC_NEST_API_URL=http://localhost:4200/api

# Password reset (production must use real email delivery)
APP_PUBLIC_URL=http://localhost:3100
MOBILE_PUBLIC_URL=http://localhost:8081
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# PASSWORD_RESET_LOG_ONLY=true  # non-production only
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@example.com

# Razorpay (Batch 10) — sandbox/test keys only until authorized live cutover
# Never invent plan prices; leave amounts empty to disable checkout.
PAYMENT_ENABLED=false
# RAZORPAY_KEY_ID=rzp_test_…
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
# PLAN_FAMILY_MONTHLY_AMOUNT_PAISE=
# PLAN_FAMILY_YEARLY_AMOUNT_PAISE=
# PLAN_EXTRA_SEAT_AMOUNT_PAISE=
TAX_RATE_BPS=0

# Mobile → website checkout handoff
# EXPO_PUBLIC_WEB_APP_URL=http://localhost:3100
# EXPO_PUBLIC_API_URL=http://localhost:4100/api

# Private media / speech — leave empty until required phases
# Never use dummy payment confirmation or claim live gateway without keys.
