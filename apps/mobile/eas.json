{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.siwiapp.shop/api",
        "EXPO_PUBLIC_WEB_APP_URL": "https://siwiapp.shop",
        "EXPO_PUBLIC_WEB_URL": "https://siwiapp.shop",
        "EXPO_PUBLIC_ENABLE_DEMO": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.siwiapp.shop/api",
        "EXPO_PUBLIC_WEB_APP_URL": "https://siwiapp.shop",
        "EXPO_PUBLIC_WEB_URL": "https://siwiapp.shop",
        "EXPO_PUBLIC_ENABLE_DEMO": "0"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.siwiapp.shop/api",
        "EXPO_PUBLIC_WEB_APP_URL": "https://siwiapp.shop",
        "EXPO_PUBLIC_WEB_URL": "https://siwiapp.shop",
        "EXPO_PUBLIC_ENABLE_DEMO": "0"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.siwiapp.shop/api",
        "EXPO_PUBLIC_WEB_APP_URL": "https://siwiapp.shop",
        "EXPO_PUBLIC_WEB_URL": "https://siwiapp.shop",
        "EXPO_PUBLIC_ENABLE_DEMO": "0"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    }
  }
}
