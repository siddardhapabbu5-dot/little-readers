{
  "expo": {
    "name": "Little Readers",
    "slug": "little-readers",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "littlereaders",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3E8FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.littlereaders.app"
    },
    "android": {
      "package": "com.littlereaders.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3E8FF"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          }
        }
      ],
      "./plugins/withAndroidKotlinFix.js"
    ],
    "extra": {
      "eas": {
        "projectId": "05c9d4b3-b240-4dc7-9f2b-648e7243e2d0"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "tjgf-hjgl"
  }
}
