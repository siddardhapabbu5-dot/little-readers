# Dependencies
node_modules/
.pnp
.pnp.js

# Build
dist/
build/
.next/
out/
.expo/
*.tsbuildinfo

# Expo CNG — never commit/upload prebuild output (EAS must regenerate)
apps/mobile/android/
apps/mobile/ios/

# Env & secrets (any .env variant, including backups such as .env.bak-*)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Local-only root Expo config (the real app config lives in apps/mobile)
/app.json

# Store / signing credentials — never commit
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
credentials.json
service-account*.json
eas-credentials/

# Logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
*.aab
*.apk
*.ipa

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Testing / coverage
coverage/
.nyc_output/

# Prisma
server/prisma/*.db
server/prisma/*.db-journal

# Uploads (keep folder)
uploads/*
!uploads/.gitkeep
server/storage/vocab-uploads/*
!server/storage/vocab-uploads/.gitkeep

# Database backups contain personal data — never commit
backups/
*.dump
*.dump.json

# Misc
*.pem
.turbo
.cache

# Dictionary uploads (keep folder)
server/storage/dictionary-uploads/*
!server/storage/dictionary-uploads/.gitkeep


apps/mobile/dist-web/
