{
  "expo": {
    "name": "LEARN WISE",
    "slug": "little-readers",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "littlereaders",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3E8FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.littlereaders.app",
      "buildNumber": "10",
      "infoPlist": {
        "CFBundleDisplayName": "LEARN WISE",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["mailto", "https", "http"],
        "NSPhotoLibraryUsageDescription": "LEARN WISE accesses photos only when you choose a profile photo or a file to upload.",
        "NSCameraUsageDescription": "LEARN WISE uses the camera only when you choose to take a profile photo.",
        "UIBackgroundModes": []
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.littlereaders.app",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3E8FF"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "littlereaders"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "LEARN WISE accesses photos only when you choose a profile photo.",
          "cameraPermission": "LEARN WISE uses the camera only when you choose to take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/withAndroidKotlinFix.js"
    ],
    "extra": {
      "eas": {
        "projectId": "05c9d4b3-b240-4dc7-9f2b-648e7243e2d0"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "tjgf-hjgl"
  }
}
