# Copy to .env and fill in real values. Never commit secrets.

# Database
POSTGRES_USER=little_readers
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=little_readers
POSTGRES_PORT=5437
DATABASE_URL=postgresql://little_readers:change_me_strong_password@localhost:5437/little_readers?schema=public

# Redis (BullMQ from Phase 2+)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Legacy Express API (preserved)
NODE_ENV=development
PORT=4100
CORS_ORIGIN=http://localhost:3100
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# NestJS API (primary going forward)
API_PORT=4200

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4100/api
NEXT_PUBLIC_NEST_API_URL=http://localhost:4200/api

# Private media / speech / payments — leave empty until required phases
# Never use dummy payment confirmation.
