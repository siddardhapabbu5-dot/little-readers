{
  "expo": {
    "name": "Little Readers",
    "slug": "little-readers",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "littlereaders",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.littlereaders.app"
    },
    "android": {
      "package": "com.littlereaders.app"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-document-picker"],
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
