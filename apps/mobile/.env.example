# Mobile client — PUBLIC values only. Never put SMS, JWT, DB, or Razorpay secrets here.

# Local development (Metro)
# EXPO_PUBLIC_API_URL=http://localhost:4100/api
# EXPO_PUBLIC_WEB_APP_URL=http://localhost:3100

# Preview / production (also set in eas.json profiles — never ship localhost)
EXPO_PUBLIC_API_URL=https://api.siwiapp.shop/api
EXPO_PUBLIC_WEB_APP_URL=https://siwiapp.shop
EXPO_PUBLIC_WEB_URL=https://siwiapp.shop

# Demo login affordances — must be 0 for production / preview store builds
EXPO_PUBLIC_ENABLE_DEMO=0
